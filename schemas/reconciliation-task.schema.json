{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dlddu.dev/reconciliation-task.schema.json",
  "title": "ReconciliationTask",
  "description": "as-is 또는 to-be의 버전 변경이 감지될 때마다 생성되는 작업 레코드. 요약 → 판단까지는 최상위 필드에, 계획 → (사용자 검토) → 실행 → 검증은 attempts[] 항목(시도) 단위로 기록한다. 마지막 항목이 현재 시도다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "toBeModelId",
    "status",
    "trigger",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rct_[a-z0-9][a-z0-9_-]*$"
    },
    "toBeModelId": {
      "type": "string",
      "description": "대상 ToBeModel의 id"
    },
    "status": {
      "description": "작업 생명주기 상태",
      "enum": [
        "assessing",
        "no_action_needed",
        "action_required",
        "planning",
        "planned",
        "reviewing",
        "review_rejected",
        "approved",
        "executing",
        "verifying",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "trigger": {
      "type": "object",
      "description": "작업을 생성시킨 계기. 버전 변경(version_change)이거나 사람의 즉시 감지 요청(manual)이다. 버전 변경이면 바뀐 쪽의 asIs/toBe 버전 기록이 하나 이상 있어야 하며, 어느 쪽이 바뀌었는지는 previousVersion≠currentVersion으로 판단한다.",
      "additionalProperties": false,
      "required": [
        "detectedAt"
      ],
      "if": {
        "properties": {
          "source": {
            "const": "manual"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "anyOf": [
          {
            "required": [
              "asIs"
            ]
          },
          {
            "required": [
              "toBe"
            ]
          }
        ]
      },
      "properties": {
        "source": {
          "enum": [
            "version_change",
            "manual"
          ],
          "default": "version_change",
          "description": "이 작업이 생긴 계기. 생략 시 version_change(버전 변경 감지). manual은 checkPolicy.manualTriggerRequestedAt로 들어온 사람의 요청이며, 이때만 asIs/toBe 버전 기록 없이 생성될 수 있다."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "이 작업을 왜 지금 열었는지. source가 manual이면 필수이며, 모델의 checkPolicy.manualTriggerReason을 그대로 옮겨 적는다(사람이 detector를 직접 부른 경우엔 그 지시 내용을 적는다). 버전 변경으로 생긴 작업은 계기가 버전 diff에 드러나므로 필요 없다."
        },
        "detectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "asIs": {
          "$ref": "#/$defs/versionChange"
        },
        "toBe": {
          "$ref": "#/$defs/versionChange"
        }
      }
    },
    "stateSummary": {
      "type": "object",
      "description": "as-is와 to-be 상태에 대한 요약",
      "additionalProperties": false,
      "required": [
        "asIs",
        "toBe"
      ],
      "properties": {
        "asIs": {
          "type": "string",
          "contentMediaType": "text/markdown"
        },
        "toBe": {
          "type": "string",
          "contentMediaType": "text/markdown"
        },
        "gap": {
          "type": "string",
          "description": "두 상태의 차이 요약"
        },
        "summarizedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "assessment": {
      "type": "object",
      "description": "작업 필요 여부 판단 결과. 판정 자체(조치 필요/불필요)는 status 전이(no_action_needed | action_required)로 기록하고, 여기에는 근거와 재확인 유예를 남긴다.",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recheckAfter": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "이 시각 이후 감지 단계를 재실행해 작업 필요 여부를 확정 (status가 assessing인 재확인 유예에서만 사용)"
        }
      }
    },
    "attempts": {
      "type": "array",
      "description": "시도(attempt) 기록의 append-only 목록. planner가 계획할 때 항목을 끝에 덧붙이고, executor가 같은 항목에 review/execution/verification을 채운다. 마지막 항목이 현재 시도이며, 이전 항목은 수정하지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "이 시도가 시작된 이유. 재작업이면 직전 status(review_rejected/failed). 첫 시도는 생략."
          },
          "plan": {
            "$ref": "#/$defs/plan"
          },
          "preparation": {
            "$ref": "#/$defs/preparation"
          },
          "decision": {
            "$ref": "#/$defs/decision"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "execution": {
            "$ref": "#/$defs/execution"
          },
          "verification": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "description": "작업 계획 (status가 action_required인 task에 대해 작성)",
      "additionalProperties": false,
      "required": [
        "summary",
        "steps"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "riskLevel": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "action"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string",
                "description": "수행할 작업 설명 또는 명령"
              },
              "expectedOutcome": {
                "type": "string"
              }
            }
          }
        },
        "plannedAt": {
          "type": "string",
          "format": "date-time"
        },
        "executionGuide": {
          "type": "string",
          "contentMediaType": "text/markdown",
          "description": "실행 순서, 단계별 검증 방법, 주의사항(롤백 포함)"
        }
      }
    },
    "preparation": {
      "type": "object",
      "description": "실행 스테이징(주로 PR) 준비 결과",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "description": "owner/repo"
        },
        "branch": {
          "type": "string"
        },
        "pullRequestUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "description": "이 시도가 사람 소유 결정을 담은 제안 PR이라는 기록. planner가 준비(PR 생성) 때 sha를 쓰고, 리뷰가 현재 PR head로 확인·갱신하며, verdict·comment는 사람 세션만 쓴다. 있으면 verdict가 approved이고 preparation.pullRequestUrl의 PR이 열려 있으며 head가 sha 그대로일 때만 실행한다. review.manualApproval과는 독립이다(둘 다 있으면 둘 다 충족해야 한다).",
      "additionalProperties": false,
      "required": [
        "sha"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "결정 대상 PR head 커밋 — 사람의 결정은 이 커밋에 묶인다"
        },
        "verdict": {
          "description": "사람의 결정. 없으면 결정 대기",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "comment": {
          "type": "string",
          "description": "결정 사유. rejected면 필수 — planner 재계획의 입력"
        }
      },
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "required": [
          "comment"
        ]
      }
    },
    "review": {
      "type": "object",
      "description": "검토 판정. 대상 레포 게이트의 사람 승인 필요 여부는 manualApproval 유무로만 표현한다(사람 소유 결정은 decision).",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "description": "검토가 필요한(또는 불필요한) 이유"
        },
        "status": {
          "description": "사용자 검토 진행 상태",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "type": "string"
        },
        "manualApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha",
            "context"
          ],
          "description": "리뷰가 승인하면서 대상 레포의 사람 승인을 요구한 기록. 있으면 preparation.pullRequestUrl의 PR이 열려 있고 head가 sha 그대로이며, sha에 붙은 context의 최신 commit status가 success일 때만 실행한다. 없으면 대상 레포 게이트의 사람 승인은 불필요(사람 소유 결정은 attempts 항목의 decision이 따로 기록한다).",
          "properties": {
            "sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "리뷰 시점의 PR head 커밋 — 승인은 이 커밋에 묶인다"
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "description": "대상 레포의 사람 승인용 required status context (예: review/manual-approval)"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "실행 내역",
      "additionalProperties": false,
      "required": [
        "status",
        "entries"
      ],
      "properties": {
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "aborted"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepSeq",
              "status"
            ],
            "properties": {
              "stepSeq": {
                "type": "integer",
                "description": "plan.steps의 seq 참조"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "skipped"
                ]
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "log": {
                "type": "string",
                "description": "stdout/stderr 요약 또는 로그 링크"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "검증 결과",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "skipped"
          ],
          "description": "passed = plan이 명시한 범위(완료 기준)를 달성하고 checks가 전부 통과. 모델 전체 to-be와의 잔여 gap은 판정에 넣지 않는다 — 실행이 만든 버전 변화의 재감지가 후속 task로 잇는다. failed = 계획한 범위조차 미달성."
        },
        "asIsVersionAfter": {
          "type": [
            "string",
            "null"
          ],
          "description": "실행 후 재계산한 as-is 버전"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "versionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentVersion"
      ],
      "properties": {
        "previousVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "변경 전 버전. 최초 관측이면 null."
        },
        "currentVersion": {
          "type": "string"
        }
      }
    }
  }
}
