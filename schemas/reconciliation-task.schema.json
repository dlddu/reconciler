{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dlddu.dev/reconciliation-task.schema.json",
  "title": "ReconciliationTask",
  "description": "as-is 또는 to-be의 버전 변경이 감지될 때마다 생성되는 작업 레코드. 요약 → 판단까지는 최상위 필드에, 계획 → (사용자 검토) → 실행 → 검증은 attempts[] 항목(시도) 단위로 기록한다. 마지막 항목이 현재 시도다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "toBeModelId",
    "status",
    "trigger",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rct_[a-z0-9][a-z0-9_-]*$"
    },
    "toBeModelId": {
      "type": "string",
      "description": "대상 ToBeModel의 id"
    },
    "status": {
      "description": "작업 생명주기 상태",
      "enum": [
        "detected",
        "assessing",
        "no_action_needed",
        "action_required",
        "planning",
        "planned",
        "reviewing",
        "awaiting_review",
        "approving",
        "review_rejected",
        "approved",
        "executing",
        "verifying",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "trigger": {
      "type": "object",
      "description": "작업을 생성시킨 버전 변경 정보",
      "additionalProperties": false,
      "required": [
        "detectedAt",
        "changedSides"
      ],
      "properties": {
        "detectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changedSides": {
          "type": "array",
          "items": {
            "enum": [
              "as_is",
              "to_be"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "버전이 변경된 쪽"
        },
        "asIs": {
          "$ref": "#/$defs/versionChange"
        },
        "toBe": {
          "$ref": "#/$defs/versionChange"
        }
      }
    },
    "stateSummary": {
      "type": "object",
      "description": "as-is와 to-be 상태에 대한 요약",
      "additionalProperties": false,
      "required": [
        "asIs",
        "toBe"
      ],
      "properties": {
        "asIs": {
          "type": "string",
          "contentMediaType": "text/markdown"
        },
        "toBe": {
          "type": "string",
          "contentMediaType": "text/markdown"
        },
        "gap": {
          "type": "string",
          "description": "두 상태의 차이 요약"
        },
        "summarizedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "assessment": {
      "type": "object",
      "description": "작업 필요 여부 판단 결과",
      "additionalProperties": false,
      "required": [
        "actionRequired",
        "reason"
      ],
      "properties": {
        "actionRequired": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "assessedBy": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "attempts": {
      "type": "array",
      "description": "시도(attempt) 기록의 append-only 목록. planner가 계획할 때 항목을 끝에 덧붙이고, executor가 같은 항목에 review/execution/verification을 채운다. 마지막 항목이 현재 시도이며, 이전 항목은 수정하지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "이 시도가 시작된 이유. 재작업이면 직전 status(review_rejected/failed). 첫 시도는 생략."
          },
          "plan": {
            "$ref": "#/$defs/plan"
          },
          "preparation": {
            "$ref": "#/$defs/preparation"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "execution": {
            "$ref": "#/$defs/execution"
          },
          "verification": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "description": "작업 계획 (assessment.actionRequired=true일 때 작성)",
      "additionalProperties": false,
      "required": [
        "summary",
        "steps"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "riskLevel": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "action"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string",
                "description": "수행할 작업 설명 또는 명령"
              },
              "expectedOutcome": {
                "type": "string"
              }
            }
          }
        },
        "plannedAt": {
          "type": "string",
          "format": "date-time"
        },
        "executionGuide": {
          "type": "string",
          "contentMediaType": "text/markdown",
          "description": "실행 순서, 단계별 검증 방법, 주의사항(롤백 포함)"
        }
      }
    },
    "preparation": {
      "type": "object",
      "description": "실행 스테이징(주로 PR) 준비 결과",
      "additionalProperties": false,
      "properties": {
        "prepared": {
          "type": "boolean"
        },
        "repository": {
          "type": "string",
          "description": "owner/repo"
        },
        "branch": {
          "type": "string"
        },
        "pullRequestUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "description": "사용자 검토",
      "additionalProperties": false,
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "사용자 검토 필요 여부"
        },
        "reason": {
          "type": "string",
          "description": "검토가 필요한(또는 불필요한) 이유"
        },
        "status": {
          "description": "사용자 검토 진행 상태",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "실행 내역",
      "additionalProperties": false,
      "required": [
        "status",
        "entries"
      ],
      "properties": {
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "aborted"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stepSeq",
              "status"
            ],
            "properties": {
              "stepSeq": {
                "type": "integer",
                "description": "plan.steps의 seq 참조"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "skipped"
                ]
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "log": {
                "type": "string",
                "description": "stdout/stderr 요약 또는 로그 링크"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "검증 결과",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "converged": {
          "type": "boolean",
          "description": "이 시도의 plan이 명시한 범위(완료 기준) 기준으로 실행 결과가 수렴했는지. 모델 전체 to-be와의 잔여 gap은 판정에 넣지 않는다 — 실행이 만든 버전 변화의 재감지가 후속 task로 잇는다."
        },
        "asIsVersionAfter": {
          "type": [
            "string",
            "null"
          ],
          "description": "실행 후 재계산한 as-is 버전"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "versionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentVersion"
      ],
      "properties": {
        "previousVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "변경 전 버전. 최초 관측이면 null."
        },
        "currentVersion": {
          "type": "string"
        }
      }
    }
  }
}
