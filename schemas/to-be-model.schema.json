{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dlddu.dev/to-be-model.schema.json",
  "title": "ToBeModel",
  "description": "to-be(목표 상태) 모델. 목표 상태의 마크다운 정의와 as-is/to-be 데이터 소스, 각 소스의 버전 계산 스크립트를 포함한다. 어느 한쪽의 버전이 바뀌면 ReconciliationTask가 생성된다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "metadata",
    "definition",
    "asIs",
    "toBe"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "모델 고유 식별자",
      "pattern": "^tbm_[a-z0-9][a-z0-9_-]*$"
    },
    "metadata": {
      "type": "object",
      "description": "모델 메타데이터",
      "additionalProperties": false,
      "required": [
        "name",
        "createdAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "definition": {
      "type": "string",
      "contentMediaType": "text/markdown",
      "description": "to-be(목표 상태)에 대한 마크다운 정의. 작업 필요 여부 판단과 계획 수립의 기준 문서."
    },
    "asIs": {
      "$ref": "#/$defs/trackedState",
      "description": "현재 상태(as-is)의 데이터 소스와 버전 계산 스크립트"
    },
    "toBe": {
      "$ref": "#/$defs/trackedState",
      "description": "목표 상태(to-be)의 데이터 소스와 버전 계산 스크립트"
    },
    "checkPolicy": {
      "type": "object",
      "description": "버전 변경 감지 정책",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "이 모델의 변경 감지를 수행할지 여부. false면 감지 sweep에서 건너뛴다(모델 정의·이력은 그대로 보존). 생략 시 true."
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "default": 300,
          "description": "버전 계산 스크립트 실행 주기(초)"
        },
        "webhookEnabled": {
          "type": "boolean",
          "default": false,
          "description": "폴링 외 웹훅으로도 변경을 수신할지 여부"
        }
      }
    }
  },
  "$defs": {
    "trackedState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataSource",
        "versionScript"
      ],
      "properties": {
        "dataSource": {
          "$ref": "#/$defs/dataSource"
        },
        "versionScript": {
          "$ref": "#/$defs/versionScript"
        },
        "lastObservedVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "마지막으로 관측된 버전 문자열(캐시). 이 값이 바뀌면 ReconciliationTask가 생성된다."
        },
        "lastObservedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "dataSource": {
      "description": "상태를 읽어오는 데이터 소스. type 필드로 구분되는 discriminated union.",
      "oneOf": [
        {
          "$ref": "#/$defs/githubDataSource"
        },
        {
          "$ref": "#/$defs/kubernetesDeploymentDataSource"
        },
        {
          "$ref": "#/$defs/monitorAlertDataSource"
        },
        {
          "$ref": "#/$defs/customDataSource"
        }
      ]
    },
    "githubDataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "repository"
      ],
      "properties": {
        "type": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "owner/repo 형식"
        },
        "ref": {
          "type": "string",
          "default": "main"
        },
        "subPath": {
          "type": "string",
          "description": "버전 계산 대상 하위 디렉터리. 버전은 커밋 SHA + 이 디렉터리의 tree hash 조합을 권장."
        }
      }
    },
    "kubernetesDeploymentDataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "namespace",
        "name"
      ],
      "properties": {
        "type": {
          "const": "kubernetes_deployment"
        },
        "cluster": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "monitorAlertDataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "monitorId"
      ],
      "properties": {
        "type": {
          "const": "monitor_alert"
        },
        "provider": {
          "type": "string",
          "examples": [
            "datadog",
            "grafana"
          ]
        },
        "monitorId": {
          "type": "string"
        }
      }
    },
    "customDataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "custom"
        },
        "description": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "description": "자유 형식 설정",
          "additionalProperties": true
        }
      }
    },
    "versionScript": {
      "type": "object",
      "description": "데이터 소스에서 버전 문자열을 계산하는 스크립트. stdout의 마지막 줄을 버전 값으로 사용한다. 예: github 커밋 SHA + 하위 디렉터리 tree hash, deployment revision + 이미지, 모니터의 최신 alert 발생 id.",
      "additionalProperties": false,
      "required": [
        "runtime",
        "code"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "bash",
            "python",
            "node"
          ]
        },
        "code": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 60
        },
        "env": {
          "type": "object",
          "description": "환경 변수. 시크릿은 값 대신 참조(secretRef:...) 사용 권장.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
